# Copy to .env for local work. In production these live in Vercel (Project ->
# Settings -> Environment Variables); a change there needs a redeploy.
# Nothing in this file is a real value — never commit a filled-in copy.

# --- Database (Supabase Postgres) — required ---
# Pooled connection, used by the app at runtime. Supabase: Project Settings ->
# Database -> Connection string -> Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (unpooled) connection, used only by `prisma migrate deploy`. Supabase:
# same page -> Session pooler (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional, local only: lets `prisma migrate deploy` run through the pooler,
# which doesn't support Postgres advisory locks.
# PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK="1"

# --- Auth — required ---
# Signs web sessions and the mobile app's 15-minute access tokens. Changing it
# signs everyone out of the web; phones recover on their next token refresh.
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# Local: http://localhost:3000  |  Production: https://complete-pool-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Scheduled jobs — required in production ---
# Shared secret guarding both cron endpoints: /api/cron/recurrence (creates
# repeating jobs) and /api/cron/photo-retention (deletes old photos). Vercel
# Cron sends it automatically once it's set. Left empty, anyone who finds
# those URLs can trigger them. Generate like NEXTAUTH_SECRET.
CRON_SECRET=""

# --- Job photos (Supabase Storage) — required for photos ---
# Server-only key used to sign photo upload and download links for the private
# `task-photos` bucket. Supabase: Project Settings -> API -> service_role.
# It bypasses all access rules: keep it out of the mobile app and the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional. Worked out from DATABASE_URL's project ref when empty.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Optional. Photos older than this many days are deleted by the cron job.
# PHOTO_RETENTION_DAYS="183"

# --- Online card payments (Stripe Checkout) — optional ---
# Leave STRIPE_SECRET_KEY empty to turn online payment off: invoices then print
# no pay link and the pay page says so. Use sk_test_… keys until you've run a
# test payment end to end, then switch both values to live ones together.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
# (locally: the whsec_… printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_WEBHOOK_SECRET=""
# Public origin used in customers' pay links and invoice QR codes. Falls back
# to NEXTAUTH_URL.
APP_URL=""

# --- Timezone — optional ---
# The business timezone is set in the app under Settings -> Business hours and
# stored in the database; job times don't depend on the server's clock. This
# only supplies the default used before that row exists.
BUSINESS_TZ="America/New_York"

# --- Public demo login — optional ---
# Turns on the login page's "Explore the demo" button for the read-only
# demo@completepool.app account (see src/lib/demo.ts). Create the account with
# `node scripts/create-demo-user.js`. Anyone can use it and it can see all real
# data, so leave this empty to hide the button.
DEMO_LOGIN_PASSWORD=""
