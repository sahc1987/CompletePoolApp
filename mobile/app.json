{
  "expo": {
    "name": "Complete Pool",
    "slug": "completepool-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.completepool.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16305e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.completepool.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Complete Pool uses the camera to take before and after photos of the pool you are working on.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "completepool",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "https://complete-pool-app.vercel.app",
      "eas": {
        "projectId": "08632dd0-6cef-4e9d-9034-e66d9fa74950"
      }
    },
    "owner": "sahc1987",
    "updates": {
      "url": "https://u.expo.dev/08632dd0-6cef-4e9d-9034-e66d9fa74950"
    }
  }
}
